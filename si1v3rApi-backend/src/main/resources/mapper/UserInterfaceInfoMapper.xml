<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.si1v3r.si1v3rApi.mapper.UserInterfaceInfoMapper">

    <resultMap id="BaseResultMap" type="com.si1v3r.si1v3rApi.model.entity.UserInterfaceInfo">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="userId" column="userId" jdbcType="BIGINT"/>
            <result property="interfaceInfoId" column="interfaceInfoId" jdbcType="BIGINT"/>
            <result property="totalNum" column="totalNum" jdbcType="INTEGER"/>
            <result property="createTime" column="createTime" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="updateTime" jdbcType="TIMESTAMP"/>
            <result property="isDelete" column="isDelete" jdbcType="TINYINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,userId,interfaceInfoId,
        totalNum,
        createTime,updateTime,isDelete
    </sql>
    <select id="listMyInvokeStats" resultType="com.si1v3r.si1v3rApi.model.vo.MyInvokeStatVO">
        SELECT c.interfaceInfoId, i.name AS interfaceName, i.url, i.method, c.totalNum, c.updateTime
        FROM user_interface_info c
        LEFT JOIN interface_info i ON i.id = c.interfaceInfoId AND i.isDelete = 0
        WHERE c.userId = #{userId} AND c.isDelete = 0
        ORDER BY c.totalNum DESC
    </select>
</mapper>
